PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (placeholder for later)
DATABASE_URL=postgresql://farmingo:farmingo@localhost:5432/farmingo

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=1d

# Weather provider
# Default provider is Open-Meteo (real API, no key).
# Set WEATHER_PROVIDER=openweathermap and WEATHER_API_KEY to use OpenWeatherMap.
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Notifications
NOTIFICATION_PROVIDER=mock
NOTIFICATION_API_KEY=
# IANA timezone for reminder/overdue cron evaluation
NOTIFICATION_TIMEZONE=Asia/Karachi

# Cloudinary (server-side only — never expose the secret to Nuxt)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (server-side only — never expose to Nuxt)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
